{
  "expo": {
    "name": "Pazaryeri",
    "slug": "pazaryeri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pazaryeri",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D1A78"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pazaryerim",
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:pazaryeri0.web.app",
        "applinks:pazaryeri0.firebaseapp.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "İlan fotoğrafı çekmek için kamera erişimi gerekli.",
        "NSPhotoLibraryUsageDescription": "İlan fotoğrafı seçmek için galeri erişimi gerekli.",
        "NSLocationWhenInUseUsageDescription": "Konumunuzu ilanınıza eklemek için konum erişimi gerekli."
      }
    },
    "android": {
      "package": "com.pazaryerim",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "pazaryeri",
              "host": "auth"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "pazaryeri0.web.app",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "pazaryeri0.web.app",
              "pathPrefix": "/kesfet"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3D1A78"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "Pazaryeri — İkinci El Alım Satım",
      "shortName": "Pazaryeri",
      "description": "Ücretsiz ilan verin, ikinci el alım satım yapın. Telefon, araç, mobilya ve daha fazlası.",
      "themeColor": "#3D1A78",
      "backgroundColor": "#F7F5FC",
      "lang": "tr",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://pazaryeri0.web.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3D1A78",
          "sounds": [
            "./assets/sounds/pazaryeri-inapp.wav",
            "./assets/sounds/pazaryeri-push.wav",
            "./assets/sounds/pazaryeri-message.wav",
            "./assets/sounds/pazaryeri-favorite.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan fotoğrafı seçmek için galeri erişimi gerekli.",
          "cameraPermission": "İlan fotoğrafı çekmek için kamera erişimi gerekli."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konumunuzu ilanınıza eklemek için konum erişimi gerekli."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "siteUrl": "https://pazaryeri0.web.app",
      "apiUrl": "https://pazaryerim.onrender.com",
      "firebase": {
        "apiKey": "AIzaSyB6W3BBz1_SpD-jp8dcpvFTjeBwnZlw4Dg",
        "authDomain": "pazaryeri0.firebaseapp.com",
        "projectId": "pazaryeri0",
        "storageBucket": "pazaryeri0.firebasestorage.app",
        "messagingSenderId": "445495602976",
        "appId": "1:445495602976:web:a9d405b30d0cab7d85f145",
        "measurementId": "G-X4KF641X5R"
      },
      "google": {
        "webClientId": "637257074433-gr8vbeupacshsv6omfsf60mn5rkef719.apps.googleusercontent.com"
      },
      "router": {
        "origin": "https://pazaryeri0.web.app"
      },
      "eas": {
        "projectId": "423cbdcd-276b-4ad2-b84d-2036eb13ab08"
      }
    },
    "owner": "pazaryeri"
  }
}
