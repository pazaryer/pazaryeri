{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Use pnpm instead'); process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "render-build": "pnpm install --ignore-scripts && pnpm --filter @workspace/api-server run build",
    "render-build:ci": "npx --yes pnpm@9.15.9 install --prod=false --no-frozen-lockfile && npx --yes pnpm@9.15.9 --filter @workspace/api-server run build",
    "web:build": "pnpm --filter @workspace/mobile run export:web",
    "web:deploy": "firebase deploy --only hosting",
    "ota:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-eas-updates.ps1",
    "setup:storage": "node scripts/setup-storage.mjs",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
